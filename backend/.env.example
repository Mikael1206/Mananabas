# Copy this file to .env and fill in your values

# --- LLM provider used for highlight ranking ---
# One of: openai | anthropic | gemini
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Transcription ---
# tiny | base | small | medium | large-v3  (bigger = more accurate, slower)
WHISPER_MODEL_SIZE=small
# cpu or cuda (cuda needs an NVIDIA GPU + drivers)
WHISPER_DEVICE=cpu
# Force a language instead of auto-detect (e.g. "tl" for Filipino/Tagalog,
# "en" for English). Leave blank to auto-detect.
WHISPER_LANGUAGE=

# --- Storage ---
MEDIA_DIR=./media
DATABASE_URL=sqlite:///./mananabas.db

# --- Clip generation ---
MAX_CLIPS_PER_JOB=5
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=90
