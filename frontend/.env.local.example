# Local Next.js → local API
NEXT_PUBLIC_API_URL=http://localhost:8000

# On Vercel, set this in Project → Settings → Environment Variables
# (or rely on .env.production) to the Railway public URL, no trailing slash:
# NEXT_PUBLIC_API_URL=https://mananabas-production.up.railway.app

# Google OAuth client ID (Web application) from Google Cloud Console →
# APIs & Services → Credentials. This is public by design (unlike a client
# secret) and must match the GOOGLE_CLIENT_ID set on the backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
