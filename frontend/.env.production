# Used by `next build` on Vercel unless you override it in the Vercel dashboard.
NEXT_PUBLIC_API_URL=https://mananabas-production.up.railway.app

# Must match the GOOGLE_CLIENT_ID configured on the Railway backend.
# Prefer overriding this in Vercel Project → Settings → Environment Variables
# rather than committing the real value here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
